# Academic Intelligence Platform - Backend Configuration
# All paths can be relative (to backend directory) or absolute

# Dataset Directory path (checks backend/data, then repo/dataset, or seed data)
DATASET_PATH=data/UG

# Machine Learning Model & Features paths
MODEL_PATH=model/xgboost_probability_model.joblib
FEATURES_PATH=model/prob_features.joblib

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Groq AI Service Configuration (Multi-Key & Multi-Model Rate-Limit Failover)
# You can provide multiple keys via GROQ_API_KEY, GROQ_API_KEY_2, GROQ_API_KEY_3 or comma-separated GROQ_API_KEYS
GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_API_KEY_2=your_secondary_groq_api_key_here
GROQ_API_KEY_3=your_tertiary_groq_api_key_here

# Primary model and automatic fallback models when rate limits are reached
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
