# Academic Intelligence Platform - Backend Configuration
# All paths can be relative (to backend directory) or absolute

# Dataset Directory path (checks backend/data, then repo/dataset, or seed data)
DATASET_PATH=data/UG

# Machine Learning Model & Features paths
MODEL_PATH=model/xgboost_probability_model.joblib
FEATURES_PATH=model/prob_features.joblib

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Groq AI Service Configuration (Optional: fallback heuristic engine operates if unset)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
